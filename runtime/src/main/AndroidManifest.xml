<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- InstallerService: a dataSync foreground service with a progress notification. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- GameActivity: this network's DNS servers for the game's own lookups. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application>
        <!-- The game runs in its own process: Minecraft calls System.exit, which must not take the
             launcher with it. Every config change is handled in place: recreating this activity
             would mean restarting the JVM. -->
        <activity
            android:name="com.ignacio.cofre.runtime.GameActivity"
            android:process=":game"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            android:configChanges="mcc|mnc|orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density|fontScale|fontWeightAdjustment|locale|layoutDirection|touchscreen|colorMode|grammaticalGender|assetsPaths"
            android:enableOnBackInvokedCallback="true"
            android:resizeableActivity="false"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen" />
        <!-- NeoForge install processors: one JVM per process, on the game's JRE and launcher. -->
        <service
            android:name="com.ignacio.cofre.runtime.launch.InstallerService"
            android:process=":installer"
            android:foregroundServiceType="dataSync"
            android:exported="false" />
    </application>
</manifest>
